# Default network to work on; can be overridden with --network param
HARDHAT_NETWORK="testnet_ethereum" 

ETHERSCAN_API_KEY=<Etherscan API Key>

TESTNET_ETHEREUM_URL=<ETHEREUM testnet (Sepolia) node URL>

POLYGON_URL=<POLYGON mainnet node URL>
TESTNET_POLYGON_URL=<POLYGON testnet (Amoy) node URL>

OPTIMISM_URL=<OPTIMISM mainnet node URL>
TESTNET_OPTIMISM_URL=<OPTIMISM testnet node URL>

TEST_PRIVATE_KEY=<Deployer testnet wallet private key>
MAIN_PRIVATE_KEY=<Deployer mainnet wallet private key>

TESTNET_BASE_URL=<Base testnet node URL>
BASE_URL=<Base mainnet node URL>

# Comma-separated Ethereum Sepolia wallets used by the Chainlink action jobs.
TESTNET_CHAINLINK_NODE_ADDRESSES=<0xNodeWallet[,0xSecondNodeWallet]>

# E2E uses TEST_PRIVATE_KEY as the action account. It needs native gas on both
# proxy testnets and sufficient UTT on canonical Ethereum Sepolia. Amounts are
# raw integer UTT units, matching the contract/task arguments.
TESTNET_ACTION_TARGET_ADDRESS=<E2E target address>
TESTNET_ENDORSE_AMOUNT=100
TESTNET_WITHDRAW_AMOUNT=1
TESTNET_DISAPPROVE_AMOUNT=50
ROLLOUT_E2E_TIMEOUT_SECONDS=600
ROLLOUT_E2E_POLL_SECONDS=5
ROLLOUT_CONFIRMATIONS=2
